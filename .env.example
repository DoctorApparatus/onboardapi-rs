# Copy to .env; read by the examples via dotenv.
# The inspector watches domain 1 by default.
ONBOARDAPI_DOMAIN=1
GNSS_SERVICE_NAME=gnss_sim
# Pin Cyclone DDS to one network interface, see the onboardapi configuration docs.
# CYCLONEDDS_URI=file:///path/to/onboardapi/config/cyclonedds/localhost.xml
RUST_LOG=info
